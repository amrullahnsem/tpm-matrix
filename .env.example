# =============================================================================
# EFLOW TPM Competency Matrix - Production Environment Configuration
# =============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8000

# Worker Processes (recommended: 2-4 for production)
WORKERS=2

# Reload Mode (always false in production)
RELOAD=false

# Automatic Database Migration on startup (true / false)
MIGRATE_ON_STARTUP=true

# Database Path (default: ./data/tpm_matrix.db)
TPM_DATABASE_PATH=./data/tpm_matrix.db

# Generated Reports Output Directory (default: ./data/reports)
TPM_REPORTS_DIR=./data/reports

# Logging level (debug, info, warning, error)
LOG_LEVEL=info
